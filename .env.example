# Copy to .env to override defaults. .env is git-ignored; model keys will also live there (M2).

# Console / API port (listens on 127.0.0.1 only)
# NEST_PORT=18800

# DEBUG / INFO / WARNING
# NEST_LOG_LEVEL=INFO

# How long received messages are kept (days)
# NEST_MESSAGE_RETENTION_DAYS=30

# QQ account tokens are written here by `nest import-snowluma`, e.g.
# NEST_QQ_<QQ号>_HTTP_TOKEN="…"
# NEST_QQ_<QQ号>_WS_TOKEN="…"
