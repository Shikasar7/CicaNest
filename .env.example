# Copy to .env to override defaults. .env is git-ignored; model keys will also live there (M2).

# Console / API port (listens on 127.0.0.1 only)
# NEST_PORT=18800

# DEBUG / INFO / WARNING
# NEST_LOG_LEVEL=INFO

# How long received messages are kept (days)
# NEST_MESSAGE_RETENTION_DAYS=30

# QQ account tokens are written here when a QQ bot is added on the console (Bot page), e.g.
# NEST_QQ_<QQ号>_HTTP_TOKEN="…"
# NEST_QQ_<QQ号>_WS_TOKEN="…"

# 联网搜索 for models that cannot search by themselves (Tavily, https://tavily.com; a free plan exists).
# Without it, only Claude (with its search option) and the ChatGPT subscription search.
# TAVILY_API_KEY="tvly-…"
